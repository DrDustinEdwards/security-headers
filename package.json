{
  "name": "@dustinedwards/security-headers",
  "version": "0.1.1",
  "private": true,
  "description": "OWASP Secure Headers Project defaults, a Content-Security-Policy built from a per-site list of what a site loads, and the check a site runs in CI to prove its responses carry them.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./headers": {
      "types": "./headers.d.mts",
      "default": "./headers.mjs"
    },
    "./csp": {
      "types": "./csp.d.mts",
      "default": "./csp.mjs"
    },
    "./check": {
      "types": "./check.d.mts",
      "default": "./check.mjs"
    },
    "./oshp": {
      "types": "./oshp-suite.d.mts",
      "default": "./oshp-suite.mjs"
    },
    "./owasp": {
      "types": "./owasp-headers.d.mts",
      "default": "./owasp-headers.mjs"
    }
  },
  "bin": {
    "check-security-headers": "./bin/check-security-headers.mjs"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "headers.mjs",
    "headers.d.mts",
    "csp.mjs",
    "csp.d.mts",
    "check.mjs",
    "check.d.mts",
    "oshp-suite.mjs",
    "oshp-suite.d.mts",
    "owasp-headers.mjs",
    "owasp-headers.d.mts",
    "oshp-tests-suite.yml",
    "update-owasp.mjs",
    "bin",
    "README.md"
  ],
  "license": "UNLICENSED"
}
